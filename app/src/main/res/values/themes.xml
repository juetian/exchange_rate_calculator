<resources>
    <style name="Theme.FxCalc" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/keypad_bg</item>
    </style>

    <style name="KeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="Key" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="backgroundTint">@color/key_bg</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Key.Func">
        <item name="backgroundTint">@color/key_func_bg</item>
    </style>

    <style name="Key.Op">
        <item name="backgroundTint">@color/key_op_bg</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Key.Equals">
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textColor">@color/key_equals_text</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>
